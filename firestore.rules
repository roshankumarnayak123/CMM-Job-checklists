rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated admins can read/write templates
    match /checklists/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Anyone can create a filled checklist or review token,
    // but only admins can read or delete them
    match /filled_checklists/{document=**} {
      allow create: if true && request.resource.data.keys().hasAll(['checklistId', 'fillerName', 'uniqueCode']);
      allow read, update, delete: if request.auth != null;
    }
    
    match /review_tokens/{document=**} {
      // Anyone can create and read a specific token (needed for review page)
      allow create: if true;
      allow read: if true;
      // Anyone can update it (to add their signature)
      allow update: if request.time < resource.data.expiresAt;
      allow delete: if request.auth != null;
    }
  }
}
