rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public uploads to checkpoint_images with constraints
    match /checkpoint_images/{imageId} {
      allow read: if true;
      allow create: if request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete, update: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
